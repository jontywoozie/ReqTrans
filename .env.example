BACKEND_PORT=43127
FRONTEND_PORT=43128

# LLM provider config (backend only)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
# Optional: set only if you want to override provider default max tokens.
# LLM_MAX_TOKENS=420
# Optional retry for temporary overload (e.g., 429/503)
LLM_RETRY_MAX=3
LLM_RETRY_BASE_MS=800
LLM_API_KEY=your_api_key_here
